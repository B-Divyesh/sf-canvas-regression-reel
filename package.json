{
  "name": "canvas-regression-reel",
  "version": "0.1.0",
  "description": "Seeded canvas input replay, tolerant PNG comparison, and self-contained visual regression reels.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./recorder": {
      "types": "./dist/recorder-public.d.ts",
      "import": "./dist/recorder-public.js",
      "require": "./dist/recorder-public.cjs"
    }
  },
  "bin": {
    "canvas-reel": "./dist/cli.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.cjs",
    "dist/index.d.ts",
    "dist/recorder-public.js",
    "dist/recorder-public.cjs",
    "dist/recorder-public.d.ts",
    "dist/cli.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:lib": "tsup src/index.ts src/cli.ts src/recorder-public.ts --format esm,cjs --dts --target node20 --splitting false",
    "build:site": "vite build --config site/vite.config.ts",
    "build": "npm run clean && npm run build:lib && npm run build:site",
    "test": "vitest run && npm run build && playwright test",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "canvas",
    "visual-regression",
    "playwright",
    "game-development",
    "testing"
  ],
  "homepage": "https://canvas-regression-reel.sociobot.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B-Divyesh/sf-canvas-regression-reel.git"
  },
  "bugs": {
    "url": "https://github.com/B-Divyesh/sf-canvas-regression-reel/issues"
  },
  "license": "MIT",
  "dependencies": {
    "pngjs": "7.0.0"
  },
  "peerDependencies": {
    "playwright": ">=1.50.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.58.2",
    "@types/node": "22.15.3",
    "@types/pngjs": "6.0.5",
    "playwright": "1.58.2",
    "tsup": "8.5.1",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
